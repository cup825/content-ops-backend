# ============================================================
# 环境变量配置模板
# 使用方法：复制此文件为 .env，填入真实值，添加到 .gitignore
# ============================================================

# 数据库配置
DB_URL=jdbc:mysql://your-rds-host:3306/content-ops-db?useSSL=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=admin
DB_PASSWORD=your_database_password_here

# JWT 配置（生产环境必须替换为高强度随机字符串，至少 64 位）
JWT_SECRET=replace_with_a_very_long_random_string_at_least_64_chars_for_production
JWT_EXPIRATION_MS=86400000

